# Copia este archivo como .env SOLO en el servidor (nunca se sube a GitHub)
DB_HOST=tu-instancia.xxxxx.us-east-1.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=cambia_esto
DB_NAME=vehiculo_iot
DB_PORT=3306

# Clave de mantenimiento opcional para Swagger / Thunder Client
API_KEY=cambia_esta_clave

# Opcionales (valores por defecto)
SESION_HORAS=8
INVITADO_MINUTOS=5
INVITADO_GRACIA_SEG=20
BLOQUEO_CONTROL_SEG=15
MAX_COMANDOS_POR_SEG=8
# 1 = permitir temporalmente que el ESP8266 se conecte sin clave (NO recomendado)
WS_PERMITIR_SIN_CLAVE=0
